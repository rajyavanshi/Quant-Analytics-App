# Flask
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=0
FRONTEND_ORIGIN=http://localhost:8501

# Frontend
FLASK_API_URL=http://127.0.0.1:5000
API_REQUEST_TIMEOUT_SECONDS=10

# Binance ingestion
BINANCE_SYMBOLS=btcusdt,ethusdt,bnbusdt,solusdt,dogeusdt
WS_BATCH_SIZE=100
WS_FLUSH_INTERVAL_SECONDS=3
WS_MAX_RECONNECT_SECONDS=60

# Analytics
ANALYTICS_SYMBOL_X=BTCUSDT
ANALYTICS_SYMBOL_Y=ETHUSDT
ANALYTICS_TIMEFRAME=1min
ANALYTICS_LOOKBACK_MINUTES=120
ANALYTICS_ZSCORE_WINDOW=60
ANALYTICS_INTERVAL_SECONDS=60

# Logging
LOG_LEVEL=INFO
